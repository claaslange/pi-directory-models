{
	"name": "pi-directory-models",
	"version": "0.1.0",
	"description": "pi extension that selects a model from the nearest ancestor .pi/settings.json",
	"keywords": ["pi-package"],
	"license": "MIT",
	"files": ["extensions", "README.md", "LICENSE"],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "npm run typecheck && npm run lint"
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": ">=0.62.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@mariozechner/pi-coding-agent": "^0.62.0",
		"@types/node": "^24.5.2",
		"typescript": "^5.9.2"
	},
	"pi": {
		"extensions": ["./extensions"]
	}
}
